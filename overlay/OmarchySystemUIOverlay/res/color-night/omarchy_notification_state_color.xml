<!-- Omarchy night variant of res/color/omarchy_notification_state_color.xml: same states and
     alphas, but materialColorOnSurface resolves to system_on_surface_dark in night (same hex
     #E4E5F0 as the stock dark chain, core/res/res/values/colors.xml:722). Transparent stays
     @android:color/transparent in both modes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state's alpha is set to 0.00 temporarily until this bug is resolved permanently
    b/313920497 Design intended alpha is 0.15-->
    <item android:state_pressed="true" android:color="@android:color/system_on_surface_dark" android:alpha="0.00" />
    <item android:state_hovered="true" android:color="@android:color/system_on_surface_dark" android:alpha="0.11" />
    <item android:color="@android:color/transparent" />
</selector>
