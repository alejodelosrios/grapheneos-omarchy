<!-- Omarchy night variant of res/color/omarchy_notification_focus_overlay_color.xml: same states,
     but materialColorSecondary resolves to system_secondary_dark in night (same hex #C0C6DC as the
     stock dark chain, core/res/res/values/colors.xml:754). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@android:color/system_secondary_dark" />
    <item android:color="@android:color/transparent" />
</selector>
