<!-- Omarchy night variant. Identical to res/drawable/notification_material_bg.xml except the
     background: system_surface_container_high_dark (same hex #1D1F26 as stock night,
     core/res/res/values/colors.xml:768) instead of ..._light. The 1dp accent stroke is kept:
     system_accent1_500 follows the theme in both modes (design-5 point 2). State/focus layers
     reference the same omarchy_* color names; the night selectors live in res/color-night/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
        android:color="?android:attr/colorControlHighlight">
    <item>
        <shape>
            <solid android:color="@android:color/system_surface_container_high_dark" />
            <stroke android:width="1dp" android:color="@android:color/system_accent1_500" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/omarchy_notification_state_color" />
        </shape>
    </item>
    <item android:id="@+id/notification_focus_overlay">
        <shape>
            <stroke android:width="3dp"
                android:color="@color/omarchy_notification_focus_overlay_color"/>
        </shape>
    </item>
</layer-list>
