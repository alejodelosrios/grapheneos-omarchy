<!-- Omarchy local copy of packages/SystemUI/res/color/notification_state_color_default.xml
     (GrapheneOS 17): same states, same alphas (pressed 0.00 / hovered 0.11 / transparent), same
     order. Private materialColorOnSurface -> public system_on_surface_light (same hex #30323A,
     core/res/res/values/colors.xml:589); private color/transparent -> public
     @android:color/transparent (public-final.xml:735). xmlns:androidprv dropped (unused
     upstream). Local name with the omarchy_ prefix on purpose: an RRO replacing
     notification_state_color_default would shadow that selector in all of SystemUI, not just in
     notification_material_bg (design-5 condition). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state's alpha is set to 0.00 temporarily until this bug is resolved permanently
    b/313920497 Design intended alpha is 0.15-->
    <item android:state_pressed="true" android:color="@android:color/system_on_surface_light" android:alpha="0.00" />
    <item android:state_hovered="true" android:color="@android:color/system_on_surface_light" android:alpha="0.11" />
    <item android:color="@android:color/transparent" />
</selector>
