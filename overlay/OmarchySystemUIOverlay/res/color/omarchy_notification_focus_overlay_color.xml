<!-- Omarchy local copy of packages/SystemUI/res/color/notification_focus_overlay_color.xml
     (GrapheneOS 17): same states (focused / default), same order. Private materialColorSecondary
     -> public system_secondary_light (same hex #585F72, core/res/res/values/colors.xml:621);
     private color/transparent -> public @android:color/transparent (public-final.xml:735).
     xmlns:androidprv dropped (unused upstream). Local name with the omarchy_ prefix: same
     condition as omarchy_notification_state_color (design-5). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@android:color/system_secondary_light" />
    <item android:color="@android:color/transparent" />
</selector>
